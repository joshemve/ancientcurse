{
  "multipart": [
    {
      "when": {
        "OR": [
          {"north": "none", "east": "none", "south": "none", "west": "none"},
          {"north": "side|up", "east": "side|up"},
          {"east": "side|up", "south": "side|up"},
          {"south": "side|up", "west": "side|up"},
          {"west": "side|up", "north": "side|up"}
        ]
      },
      "apply": {"model": "ancientcurse:block/salt_dust_dot"}
    },
    {
      "when": {"OR": [{"north": "side|up"}, {"north": "none", "east": "none", "south": "side|up", "west": "none"}]},
      "apply": {"model": "ancientcurse:block/salt_dust_line0"}
    },
    {
      "when": {"OR": [{"east": "side|up"}, {"north": "none", "east": "none", "south": "none", "west": "side|up"}]},
      "apply": {"model": "ancientcurse:block/salt_dust_line0", "y": 90}
    },
    {
      "when": {"OR": [{"south": "side|up"}, {"north": "side|up", "east": "none", "south": "none", "west": "none"}]},
      "apply": {"model": "ancientcurse:block/salt_dust_line1"}
    },
    {
      "when": {"OR": [{"west": "side|up"}, {"north": "none", "east": "side|up", "south": "none", "west": "none"}]},
      "apply": {"model": "ancientcurse:block/salt_dust_line1", "y": 90}
    },
    {
      "when": {"north": "up"},
      "apply": {"model": "ancientcurse:block/salt_dust_line2"}
    },
    {
      "when": {"east": "up"},
      "apply": {"model": "ancientcurse:block/salt_dust_line2", "y": 90}
    },
    {
      "when": {"south": "up"},
      "apply": {"model": "ancientcurse:block/salt_dust_line3"}
    },
    {
      "when": {"west": "up"},
      "apply": {"model": "ancientcurse:block/salt_dust_line3", "y": 90}
    }
  ]
}