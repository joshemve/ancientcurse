{
  "aquifers_enabled": true,
  "default_block": {
    "Name": "minecraft:stone"
  },
  "default_fluid": {
    "Name": "minecraft:water",
    "Properties": {
      "level": "0"
    }
  },
  "disable_mob_generation": false,
  "legacy_random_source": false,
  "noise": {
    "height": 384,
    "min_y": -64,
    "size_horizontal": 1,
    "size_vertical": 2
  },
  "noise_router": {
    "barrier": {
      "type": "minecraft:constant",
      "argument": 0.0
    },
    "continents": {
      "type": "minecraft:constant",
      "argument": 0.8
    },
    "depth": {
      "type": "minecraft:add",
      "argument1": {
        "type": "minecraft:noise",
        "noise": "minecraft:surface",
        "xz_scale": 0.1,
        "y_scale": 0.0
      },
      "argument2": {
        "type": "minecraft:mul",
        "argument1": 0.3,
        "argument2": {
          "type": "minecraft:noise",
          "noise": "minecraft:surface_secondary",
          "xz_scale": 0.05,
          "y_scale": 0.0
        }
      }
    },
    "erosion": {
      "type": "minecraft:noise",
      "noise": "minecraft:erosion",
      "xz_scale": 0.2,
      "y_scale": 0.0
    },
    "final_density": {
      "type": "minecraft:add",
      "argument1": {
        "type": "minecraft:y_clamped_gradient",
        "from_value": 1.0,
        "from_y": -64,
        "to_value": -1.0,
        "to_y": 90
      },
      "argument2": {
        "type": "minecraft:add",
        "argument1": {
          "type": "minecraft:mul",
          "argument1": 0.2,
          "argument2": {
            "type": "minecraft:noise",
            "noise": "minecraft:surface",
            "xz_scale": 0.05,
            "y_scale": 0.0
          }
        },
        "argument2": {
          "type": "minecraft:mul",
          "argument1": 0.1,
          "argument2": {
            "type": "minecraft:noise",
            "noise": "minecraft:ridge",
            "xz_scale": 0.02,
            "y_scale": 0.0
          }
        }
      }
    },
    "fluid_level_floodedness": {
      "type": "minecraft:noise",
      "noise": "minecraft:aquifer_fluid_level_floodedness",
      "xz_scale": 1.0,
      "y_scale": 0.0
    },
    "fluid_level_spread": {
      "type": "minecraft:noise",
      "noise": "minecraft:aquifer_fluid_level_spread",
      "xz_scale": 1.0,
      "y_scale": 0.0
    },
    "initial_density_without_jaggedness": {
      "type": "minecraft:y_clamped_gradient",
      "from_value": 1.0,
      "from_y": -64,
      "to_value": -1.0,
      "to_y": 90
    },
    "lava": {
      "type": "minecraft:constant",
      "argument": 0.0
    },
    "ridges": {
      "type": "minecraft:noise",
      "noise": "minecraft:ridge",
      "xz_scale": 0.1,
      "y_scale": 0.0
    },
    "temperature": {
      "type": "minecraft:noise",
      "noise": "minecraft:temperature",
      "xz_scale": 0.25,
      "y_scale": 0.0
    },
    "vegetation": {
      "type": "minecraft:noise",
      "noise": "minecraft:vegetation",
      "xz_scale": 0.25,
      "y_scale": 0.0
    },
    "vein_gap": {
      "type": "minecraft:constant",
      "argument": 0.0
    },
    "vein_ridged": {
      "type": "minecraft:constant",
      "argument": 0.0
    },
    "vein_toggle": {
      "type": "minecraft:constant",
      "argument": 0.0
    }
  },
  "ore_veins_enabled": false,
  "sea_level": 60,
  "spawn_target": [
    {
      "continentalness": [0.0, 1.0],
      "depth": 0.0,
      "erosion": [0.0, 1.0],
      "humidity": [-1.0, 1.0],
      "offset": 0.0,
      "temperature": [0.8, 1.0],
      "weirdness": [-1.0, 1.0]
    }
  ],
  "surface_rule": {
    "type": "minecraft:sequence",
    "sequence": [
      {
        "type": "minecraft:condition",
        "if_true": {
          "type": "minecraft:vertical_gradient",
          "false_at_and_above": {"above_bottom": 5},
          "random_name": "minecraft:bedrock_floor",
          "true_at_and_below": {"above_bottom": 0}
        },
        "then_run": {
          "type": "minecraft:block",
          "result_state": {"Name": "minecraft:bedrock"}
        }
      },
      {
        "type": "minecraft:condition",
        "if_true": {"type": "minecraft:above_preliminary_surface"},
        "then_run": {
          "type": "minecraft:sequence",
          "sequence": [
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:water",
                "add_stone_depth": false,
                "offset": -1,
                "surface_depth_multiplier": 0
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": {"Name": "ancientcurse:nile_river_sand"}
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:stone_depth",
                "add_surface_depth": true,
                "offset": 0,
                "secondary_depth_range": 0,
                "surface_type": "floor"
              },
              "then_run": {
                "type": "minecraft:sequence",
                "sequence": [
                  {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:biome",
                      "biome_is": ["ancientcurse:deshret_desert"]
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": {"Name": "ancientcurse:deshret_sand"}
                    }
                  },
                  {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:noise_threshold",
                      "noise": "minecraft:surface",
                      "max_threshold": -0.1,
                      "min_threshold": -0.3
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": {"Name": "minecraft:red_sand"}
                    }
                  },
                  {
                    "type": "minecraft:block",
                    "result_state": {"Name": "ancientcurse:smooth_sand"}
                  }
                ]
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:stone_depth",
                "add_surface_depth": true,
                "offset": 1,
                "secondary_depth_range": 3,
                "surface_type": "floor"
              },
              "then_run": {
                "type": "minecraft:sequence",
                "sequence": [
                  {
                    "type": "minecraft:condition",
                    "if_true": {
                      "type": "minecraft:biome",
                      "biome_is": ["ancientcurse:deshret_desert"]
                    },
                    "then_run": {
                      "type": "minecraft:block",
                      "result_state": {"Name": "ancientcurse:deshret_sandstone"}
                    }
                  },
                  {
                    "type": "minecraft:block",
                    "result_state": {"Name": "minecraft:sandstone"}
                  }
                ]
              }
            },
            {
              "type": "minecraft:condition",
              "if_true": {
                "type": "minecraft:stone_depth",
                "add_surface_depth": true,
                "offset": 4,
                "secondary_depth_range": 6,
                "surface_type": "floor"
              },
              "then_run": {
                "type": "minecraft:block",
                "result_state": {"Name": "minecraft:smooth_sandstone"}
              }
            },
            {
              "type": "minecraft:block",
              "result_state": {"Name": "minecraft:stone"}
            }
          ]
        }
      }
    ]
  }
}